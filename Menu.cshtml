@* Menu.cshtml *@
@section Styles {
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="top-nav">
    <div class="logo-container">
        <img src="~/images/ssp-logo.png" alt="SSP Logo" class="logo">
    </div>

    <div class="right-nav">
        <a href="@Url.Action("Settings", "Home")" class="settings-icon">
            <img src="https://cdn-icons-png.flaticon.com/512/3524/3524659.png" alt="Settings">
        </a>

        <div class="admin-profile">
            <span>Admin</span>
            <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" alt="Profile" class="profile-icon">
        </div>
    </div>
</div>

<!-- Menu Options -->
<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="menu-options d-flex justify-content-center flex-wrap" style="margin-top: -30px;">
      
        <div class="menu-card">
            <img src="https://cdn-icons-png.flaticon.com/512/2331/2331970.png" alt="Invoices" />
            <h3>Invoices</h3>
            <p>View and manage all invoices.</p>
            <a href="@Url.Action("Invoices", "Invoice")" class="btn btn-primary">Enter</a>
        </div>

        <div class="menu-card">
            <img src="https://cdn-icons-png.flaticon.com/512/3076/3076122.png" alt="Truck Drivers" />
            <h3>Truck Drivers</h3>
            <p>Manage truck drivers and their details.</p>
            <a href="@Url.Action("TruckerList", "Truck")" class="btn btn-primary">Enabled</a>
        </div>

        <div class="menu-card">
            <img src="https://cdn-icons-png.flaticon.com/512/619/619034.png" alt="Shop Items" />
            <h3>Shop Items</h3>
            <p>View all items sold by the shop.</p>
            <a href="@Url.Action("SelectItems", "Item")" class="btn btn-primary">Enabled</a>
        </div>
    </div>
</div>

<style>
   
    .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 40px;
        background-color: white;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        position: fixed;
        width: 100%;
        top: 0;
        left: 0;
        z-index: 1000;
    }

    .logo-container {
        flex: 1;
    }

    .logo {
        width: 150px;
        height: auto;
    }

    .right-nav {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .settings-icon img {
        width: 30px;
        height: 30px;
        cursor: pointer;
        transition: opacity 0.3s ease-in-out;
    }

        .settings-icon img:hover {
            opacity: 0.7;
        }

    .admin-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: bold;
    }

    .profile-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e0d5f6;
        padding: 5px;
        cursor: pointer;
        transition: transform 0.2s ease-in-out;
    }

        .profile-icon:hover {
            transform: scale(1.1);
        }

    .menu-container {
        text-align: center;
        width: 100%;
        padding-top: 80px; 
    }

    .menu-options {
        display: flex;
        gap: 30px;
    }

    .menu-card {
        background: white;
        padding: 20px;
        border-radius: 20px;
        box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.1);
        text-align: center;
        width: 250px;
    }

        .menu-card img {
            width: 80px;
            height: auto;
            margin-bottom: 10px;
        }

    .btn-primary {
        background-color: #6b4ca3;
        border-radius: 20px;
        padding: 10px;
        display: block;
        text-align: center;
        color: white;
    }
</style>
