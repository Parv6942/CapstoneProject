@model CapstoneProject.Models.Trucker

@using (Html.BeginForm("InputTrucker", "Truck", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <p>There are errors in the form. Please correct them and try again.</p>
        </div>
    }

    <div class="form-group mt-3">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control @(ViewData.ModelState["FirstName"]?.Errors.Any() == true ? "is-invalid" : "")" />
        <span class="text-danger" asp-validation-for="FirstName"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control @(ViewData.ModelState["LastName"]?.Errors.Any() == true ? "is-invalid" : "")" />
        <span class="text-danger" asp-validation-for="LastName"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="TruckerId"></label>
        <input asp-for="TruckerId" class="form-control @(ViewData.ModelState["TruckerId"]?.Errors.Any() == true ? "is-invalid" : "")" />
        <span class="text-danger" asp-validation-for="TruckerId"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Check</button>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
}
