@model CapstoneProject.Models.Trucker

@{
    ViewData["Title"] = "Edit Trucker";
}

<h1>Edit Trucker</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <h4>Trucks</h4>
    <div id="truckInputs">
        @if (Model.Trucks != null && Model.Trucks.Any())
        {
            foreach (var truck in Model.Trucks)
            {
                <div class="form-group">
                    <label>Truck Number</label>
                    <input type="text" name="truckNumbers" value="@truck.TruckNumber" class="form-control" />
                </div>
            }
        }
        else
        {
            <div class="form-group">
                <label>Truck Number</label>
                <input type="text" name="truckNumbers" class="form-control" />
            </div>
        }
    </div>
    <button type="button" id="addTruck" class="btn btn-secondary">Add Another Truck</button>

    <br /><br />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('addTruck').addEventListener('click', function () {
            var div = document.createElement('div');
            div.className = "form-group";
            div.innerHTML = '<label>Truck Number</label><input type="text" name="truckNumbers" class="form-control" />';
            document.getElementById('truckInputs').appendChild(div);
        });
    </script>
}
