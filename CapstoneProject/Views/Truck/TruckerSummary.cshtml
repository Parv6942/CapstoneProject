@model CapstoneProject.Models.Trucker

<div class="container">
    <h2>Summary for @Model.FirstName @Model.LastName</h2>
    <p>Trucker ID: @Model.TruckerId</p>
    <p>Total Spent: $@Model.TotalSpent</p>

    <h3>Transaction History:</h3>
    <ul>
        @if (Model.Transactions.Any())
        {
            foreach (var transaction in Model.Transactions)
            {
                <li>@transaction.Item.Name - Quantity: @transaction.Quantity - Total: $@transaction.TotalPrice</li>
            }
        }
        else
        {
            <p>No transactions available.</p>
        }
    </ul>



    <div class="mt-3">
        <form asp-action="ClearTransactions" asp-controller="Truck" method="post">
            <input type="hidden" name="truckerId" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Clear Transactions</button>
        </form>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("SelectItems", "Item", new { truckerId = Model.Id })">
            <button type="button" class="btn btn-primary">Add Another Transaction</button>
        </a>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("TruckerList", "Truck")">
            <button type="button" class="btn btn-secondary">View All Truckers</button>
        </a>
    </div>



</div>
