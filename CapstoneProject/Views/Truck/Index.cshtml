@model IEnumerable<CapstoneProject.Models.Trucker>

@{
    ViewData["Title"] = "Truckers";
}

<h1>Truckers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Trucker</a>
    <a asp-controller="Home" asp-action="Menu" class="btn btn-secondary">Back to Menu</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trucker in Model)
        {
            <tr>
                <td>@trucker.FullName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@trucker.Id" class="btn btn-info">View Trucks</a>
                    <a asp-action="Edit" asp-route-id="@trucker.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@trucker.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
