@model CapstoneProject.Models.Trucker

@{
    ViewData["Title"] = "Delete Trucker";
}

<h1>Delete Trucker</h1>

<h3>Are you sure you want to delete this trucker and all associated trucks?</h3>

<div>
    <h4>@Model.FullName</h4>
    <h4>Trucks:</h4>
    <ul>
        @foreach (var truck in Model.Trucks)
        {
            <li>@truck.TruckNumber</li>
        }
    </ul>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
