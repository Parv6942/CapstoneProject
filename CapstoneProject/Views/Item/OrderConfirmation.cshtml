@model CapstoneProject.Models.Invoice

<h2>Order Confirmation</h2>
<p>Thank you for your order! Your invoice details are below:</p>

<h3>Invoice</h3>
<p><strong>Invoice ID:</strong> @Model.Id</p>
<p><strong>Trucker:</strong> @Model.Trucker.FullName</p>
<p><strong>Date:</strong> @Model.InvoiceDate.ToString("MMMM dd, yyyy")</p>

<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cartItem in Model.CartItems)
        {
                <tr>
                    <td>@cartItem.Name</td>
                    <td>@cartItem.Quantity</td>
                    <td>$@cartItem.Price.ToString("0.00")</td>
                    <td>$@cartItem.TotalPrice.ToString("0.00")</td>
                </tr>
        }
    </tbody>
</table>

<p><strong>Grand Total:</strong> $@Model.TotalPrice.ToString("0.00")</p>

<a href="@Url.Action("ViewInvoice", "Invoice", new { id = Model.Id })" class="btn btn-primary">View Invoice</a>

<a href="@Url.Action("SelectItems", "Item")" class="btn btn-secondary">Back to Shop</a>
