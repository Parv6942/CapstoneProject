@model IEnumerable<CapstoneProject.Models.Item>

@{
    ViewData["Title"] = "Manage Items";
}

<h1>Manage Items</h1>

<p>
    <a asp-action="AdminCreate" class="btn btn-primary">Add New Item</a>
    <a asp-action="SelectItems" class="btn btn-secondary">Back to Store</a>
<a asp-controller="Home" asp-action="Menu" class="btn btn-secondary">Back to Menu</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="~/images/@item.ImageUrl" alt="@item.Name" width="50" />
                    }
                </td>
                <td>
                    <a asp-action="AdminEdit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="AdminDelete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
