@model List<CapstoneProject.Models.CartItemViewModel>

@if (Model != null && Model.Any())
{
    <ul id="cart-list">
        @foreach (var cartItem in Model)
        {
            <li class="cart-item">
                <span>@cartItem.Name (x @cartItem.Quantity) - $@cartItem.TotalPrice.ToString("0.00")</span>
            </li>
        }
    </ul>
    <p><strong>Total:</strong> $<span id="total-price">@Model.Sum(i => i.TotalPrice).ToString("0.00")</span></p>
}
else
{
    <p>Your cart is empty.</p>
}
