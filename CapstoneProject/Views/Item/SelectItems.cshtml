@model IEnumerable<CapstoneProject.Models.Item>

@section Styles {
    <link rel="stylesheet" href="~/css/SelectItems.css" asp-append-version="true" />
}

<div class="container">
    <div class="back-button">
        <a href="@Url.Action("Menu", "Home")">
            <img src="https://cdn-icons-png.flaticon.com/512/860/860790.png" alt="Back to Menu" />
        </a>
    </div>

    <h2 class="section-title">Shop Items</h2>

    <!-- Items Grid -->
    <div class="items-grid">
        @foreach (var item in Model)
        {
            <div class="item-card">
                <img src="@Url.Content("~/images/" + item.ImageUrl)" alt="@item.Name" class="item-image" />
                <h4>@item.Name</h4>
                <p class="item-price">Price: $@item.Price.ToString("0.00")</p>
                <div class="quantity-container">
                    <label>Quantity:</label>
                    <input type="number" class="quantity-input" data-id="@item.Id" min="1" value="1" />
                </div>
                <div class="button-group">
                    <button class="btn btn-primary add-to-cart" data-id="@item.Id">Add to Cart</button>
                    <button class="btn btn-danger remove-from-cart" data-id="@item.Id">Remove</button>
                </div>
            </div>
        }
    </div>

    <!-- Receipt Section -->
    <div id="receipt-section">
        <h3 class="section-title">Receipt</h3>
        <div class="receipt-details" id="receipt-details">Loading receipt...</div>
    </div>


    <!-- Trucker Selection Form -->
    <form id="truckerForm" method="post" action="@Url.Action("SetTrucker", "Item")">
        <label for="truckerId">Select Trucker:</label>
        <select name="truckerId" id="truckerId" required>
            <option value="">Choose...</option>
            @foreach (var trucker in ViewBag.Truckers)
            {
                <option value="@trucker.Id">@trucker.FullName</option>
            }
        </select>
        <button type="submit" class="btn btn-submit">Submit</button>
    </form>


</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            function updateReceipt() {
                $.get('/Item/ViewReceipt', function (data) {
                    console.log("Receipt Updated:", data);
                    $('#receipt-details').html(data); // Ensure this element exists
                }).fail(function () {
                    console.log("Error loading receipt");
                });
            }

            $('.add-to-cart').click(function () {
                var itemId = $(this).data('id');
                var quantity = $('.quantity-input[data-id="' + itemId + '"]').val();

                $.post('/Item/AddToCart', { itemId: itemId, quantity: quantity }, function () {
                    updateReceipt();
                }).fail(function () {
                    console.log("Error adding item to cart");
                });
            });

            $('.remove-from-cart').click(function () {
                var itemId = $(this).data('id');

                $.post('/Item/RemoveFromCart', { itemId: itemId }, function () {
                    updateReceipt();
                }).fail(function () {
                    console.log("Error removing item from cart");
                });
            });

            updateReceipt(); // Ensure receipt loads initially
        });
    </script>

}
