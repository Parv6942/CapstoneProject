@model CapstoneProject.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SSP</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column justify-content-center align-items-center" style="height: 100vh; background-color: #f8f9fa;">

    <div class="logo-container">
        <img src="~/images/ssp-logo.png" alt="SSP Logo" class="logo">
    </div>

    <div class="login-form text-center p-4">
        @using (Html.BeginForm("Login", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-container">
                <div class="mb-3">
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Username" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-check form-switch mt-3">
                <input class="form-check-input" type="checkbox" id="rememberMe">
                <label class="form-check-label" for="rememberMe">Remember Password?</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4 login-btn">Log In</button>
        }
    </div>

</body>
</html>

<style>
    /* Center the logo and move it higher */
    .logo-container {
        text-align: center;
        margin-bottom: 30px;
        margin-top: -50px; /* Moves it higher */
    }

    .logo {
        width: 350px; /* Increased size */
        height: auto;
    }

    /* Login Form */
    .login-form {
        text-align: center;
        max-width: 450px;
    }

    /* Input Fields */
    .form-container {
        padding: 20px;
        border-radius: 50px;
        background: rgba(200, 200, 200, 0.2);
    }

    .form-control {
        border: none;
        border-radius: 30px;
        padding: 12px;
        text-align: center;
        width: 100%;
        box-shadow: inset 2px 2px 5px rgba(0, 0, 0, 0.1);
    }

    /* Login Button */
    .btn-primary.login-btn {
        border-radius: 30px;
        padding: 12px;
        font-size: 1.1rem;
        width: 100%;
        background: #6b4ca3;
        border: none;
        transition: background 0.3s ease-in-out;
    }

        .btn-primary.login-btn:active {
            background: #007bff;
        }

</style>
